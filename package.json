{
  "name": "@kernlang/agon-engines",
  "version": "0.1.3",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "description": "Engine substrates that drive third-party CLI/API agents on behalf of agon. Polyglot: TS twin in this directory, Python twin in .py files side-by-side.",
  "keywords": [
    "agon",
    "kernlang",
    "ai",
    "cli",
    "engine",
    "claude",
    "pty"
  ],
  "homepage": "https://github.com/KERNlang/kern-engines#readme",
  "bugs": {
    "url": "https://github.com/KERNlang/kern-engines/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KERNlang/kern-engines.git"
  },
  "author": "KERNlang",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli/claude": {
      "import": "./dist/cli/claude.js",
      "types": "./dist/cli/claude.d.ts"
    },
    "./cli/claude.js": "./dist/cli/claude.js",
    "./cli/session": {
      "import": "./dist/cli/session.js",
      "types": "./dist/cli/session.d.ts"
    },
    "./cli/session.js": "./dist/cli/session.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "py/kern_engines/**/*.py",
    "pyproject.toml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -b tsconfig.json --force",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {}
}
